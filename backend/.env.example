# Copy this file to .env for local development (never commit the real .env
# — it's already in .gitignore). In production (e.g. Render), set these as
# plain environment variables in the host's dashboard instead of a file.

PORT=8712

# MySQL-compatible database connection — works against a local MySQL/MariaDB
# for development, and against a managed TiDB cluster (e.g. TiDB Cloud) in
# production, with no code change either way.
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=rahee
# TiDB Cloud (and most managed hosts) require TLS — set this to "true" there.
DB_SSL=false
